# ==========================================
# HemoAlerta — Frontend Next.js (.gitignore)
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/
/build

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables
.env
.env*.local
!.env.example

# Vercel deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
*.pem
Thumbs.db
Desktop.ini
